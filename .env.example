# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456:replace_with_token_from_botfather

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database (Prisma + SQLite) ────────────────────────────
DATABASE_URL="file:./data/raport.db"

# ── Filesystem ────────────────────────────────────────────
TEMPLATES_DIR=./templates
OUTPUT_DIR=./generated

# ── LibreOffice (DOCX → PDF) ──────────────────────────────
# Linux/macOS: libreoffice
# Windows: full path to soffice.exe
LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe

# ── Payment (Click UZ) ────────────────────────────────────
# Sum amount per generated document
PAYMENT_AMOUNT=1500

# Port for the Click webhook HTTP server
PAYMENT_WEBHOOK_PORT=3000

# Set to "true" for development — every "🔍 Check payment" press will
# auto-mark the payment as paid without a real Click transaction.
CLICK_TEST_MODE=true

# Production credentials — leave empty in test mode.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Where Click redirects the user after payment (your bot deeplink).
CLICK_RETURN_URL=https://t.me/your_bot_username

# ── Payment (Payme / Paycom) ──────────────────────────────
# Same idea as CLICK_TEST_MODE — when "true", the "Check payment"
# button auto-marks Payme payments as paid without a real transaction.
PAYME_TEST_MODE=true

# Production credentials — leave empty in test mode.
# PAYME_MERCHANT_ID is the m=... value Paycom gives you.
# PAYME_KEY is the secret used for Basic auth on /payme/callback webhook.
PAYME_MERCHANT_ID=
PAYME_KEY=

# Where Paycom redirects the user after payment.
PAYME_RETURN_URL=https://t.me/your_bot_username

# ── QR / Public download ──────────────────────────────────
# Bot username (without @) — used for QR deeplink fallback.
BOT_USERNAME=your_bot_username

# If set, QR codes embedded in documents point to
#   <PUBLIC_BASE_URL>/download/<token>
# served by the same webhook server.
# Leave empty to use Telegram deeplinks instead:
#   https://t.me/<BOT_USERNAME>?start=doc_<token>
PUBLIC_BASE_URL=

# ── AI rewrite (Anthropic Claude) ─────────────────────────
# Optional. When set, the wizard offers a "✨ Rewrite legally" button
# on free-form multiline fields. Leave empty to disable the feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Voice → text (Whisper, OpenAI-compatible API) ────────
# Optional. When set, the wizard accepts Telegram voice/audio messages
# on free-form text fields (FIO / address / text / multiline) and
# transcribes them via any OpenAI-compatible Whisper endpoint.
#
# RECOMMENDED — Groq (free tier, much faster than OpenAI):
#   1. Get a key at https://console.groq.com/keys
#   2. Set:
#        OPENAI_API_KEY=gsk_...
#        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#        OPENAI_TRANSCRIBE_MODEL=whisper-large-v3
#
# OpenAI (requires paid balance):
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_TRANSCRIBE_MODEL=whisper-1
#
# Leave OPENAI_API_KEY empty to disable the feature.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1
