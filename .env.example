# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456:replace_with_token_from_botfather

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database (Prisma + PostgreSQL — NATIVE on host) ───────
# Postgres runs natively on the Ubuntu host (NOT in a container),
# listening on the default 127.0.0.1:5432. The bot container uses
# `network_mode: host` in docker-compose.yml, so it shares the host's
# network namespace and reaches Postgres at `localhost:5432` — same
# as a native app would.
#
# Use a STRONG password (openssl rand -base64 32) and keep this file
# off Git — `.env` is already in `.gitignore`.
DATABASE_URL="postgresql://ariza:STRONG-PASSWORD@localhost:5432/ariza?schema=public"

# ── Filesystem ────────────────────────────────────────────
TEMPLATES_DIR=./templates
OUTPUT_DIR=./generated
# Hours to keep generated documents on disk before the hourly cleanup
# removes them. The file is already sent to the user in chat; this only
# backs the temporary QR / /download/<token> link. Lower it to save more
# disk (e.g. 6), raise it for longer-lived links, or 0 to disable cleanup.
GENERATED_RETENTION_HOURS=24

# ── LibreOffice (DOCX → PDF) ──────────────────────────────
# Linux/macOS: libreoffice
# Windows: full path to soffice.exe
LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe

# ── Payment (Click UZ + Payme) ────────────────────────────
# Master switch. When false, the wizard skips the provider picker
# and Pay buttons — preview confirmation → PDF is generated and sent
# immediately. Flip to true once the audience is built and you want
# to monetise. PAYMENT_AMOUNT / CLICK_* / PAYME_* below stay valid
# and are read only when this is true.
PAYMENT_ENABLED=false

# Sum amount per generated document (used only when PAYMENT_ENABLED=true)
PAYMENT_AMOUNT=1500

# Port for the Click webhook HTTP server
PAYMENT_WEBHOOK_PORT=3000

# Set to "true" for development — every "🔍 Check payment" press will
# auto-mark the payment as paid without a real Click transaction.
CLICK_TEST_MODE=true

# Production credentials — leave empty in test mode.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# Where Click redirects the user after payment (your bot deeplink).
CLICK_RETURN_URL=https://t.me/your_bot_username

# ── Payment (Payme / Paycom) ──────────────────────────────
# Same idea as CLICK_TEST_MODE — when "true", the "Check payment"
# button auto-marks Payme payments as paid without a real transaction.
PAYME_TEST_MODE=true

# Production credentials — leave empty in test mode.
# PAYME_MERCHANT_ID is the m=... value Paycom gives you.
# PAYME_KEY is the secret used for Basic auth on /payme/callback webhook.
PAYME_MERCHANT_ID=
PAYME_KEY=

# Where Paycom redirects the user after payment.
PAYME_RETURN_URL=https://t.me/your_bot_username

# ── Public channel ────────────────────────────────────────
# Telegram channel URL shown as the "Каналга ўтиш" inline button next to
# the support button under "Bot haqida" (/about). Leave empty to hide it.
CHANNEL_URL=https://t.me/ArizaPro

# ── QR / Public download ──────────────────────────────────
# Bot username (without @) — used for QR deeplink fallback.
BOT_USERNAME=your_bot_username

# If set, QR codes embedded in documents point to
#   <PUBLIC_BASE_URL>/download/<token>
# served by the same webhook server.
# Leave empty to use Telegram deeplinks instead:
#   https://t.me/<BOT_USERNAME>?start=doc_<token>
PUBLIC_BASE_URL=

# ── AI rewrite (Anthropic Claude) ─────────────────────────
# Optional. When set, the wizard offers a "✨ Rewrite legally" button
# on free-form multiline fields. Leave empty to disable the feature.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Voice → text (Whisper, OpenAI-compatible API) ────────
# Optional. When set, the wizard accepts Telegram voice/audio messages
# on free-form text fields (FIO / address / text / multiline) and
# transcribes them via any OpenAI-compatible Whisper endpoint.
#
# RECOMMENDED — Groq (free tier, much faster than OpenAI):
#   1. Get a key at https://console.groq.com/keys
#   2. Set:
#        OPENAI_API_KEY=gsk_...
#        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#        OPENAI_TRANSCRIBE_MODEL=whisper-large-v3
#
# OpenAI (requires paid balance):
#   OPENAI_API_KEY=sk-...
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_TRANSCRIBE_MODEL=whisper-1
#
# Leave OPENAI_API_KEY empty to disable the feature.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Chat model for «AI-Yurist» via the SAME OpenAI-compatible endpoint
# (OPENAI_API_KEY + OPENAI_BASE_URL). On Groq (free) use:
#   OPENAI_CHAT_MODEL=llama-3.3-70b-versatile
# When OPENAI_API_KEY is set, AI-Yurist uses this instead of Anthropic.
OPENAI_CHAT_MODEL=llama-3.3-70b-versatile

# ── Feedback / suggestions ────────────────────────────────
# Telegram chat ID of the group that receives users' "Ариза бўйича
# шикоят ва таклифлар" messages. Groups are negative, e.g.
#   FEEDBACK_GROUP_ID=-1001234567890
# How to get it: add the bot to the group, then forward a group message
# to @userinfobot, or read it from getUpdates. Leave empty to hide the
# feedback button.
FEEDBACK_GROUP_ID=
