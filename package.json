{
  "name": "raport-bot",
  "version": "1.0.0",
  "description": "Telegram bot for generating Uzbek 'Ariza' legal application documents (DOCX/PDF)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "template:sample": "tsx scripts/create-sample-template.ts",
    "template:seed": "tsx scripts/seed-templates.ts",
    "avatar": "tsx scripts/render-avatar.ts",
    "bootstrap": "npm run prisma:generate && npm run prisma:push && npm run template:sample && npm run template:seed"
  },
  "keywords": [
    "telegram",
    "bot",
    "docx",
    "pdf",
    "ariza",
    "uzbek",
    "telegraf"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@prisma/client": "^5.22.0",
    "docxtemplater": "^3.50.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "pizzip": "^3.1.7",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "docx": "^9.0.2",
    "prisma": "^5.22.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
